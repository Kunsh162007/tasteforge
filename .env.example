# Qloo (hackathon key; works only against the hackathon base URL)
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_MODE=mock           # mock | live

# LLM (free tiers). Two ordered chains, one per call type. A model that answers 429, 503 or "quota exhausted" cools down
# (daily quotas until 00:00 UTC, others for the server's retry-after) and the next one is used, so a few small free
# tiers add up to enough requests for a judging period. Models without a key are skipped. The chains share cooldowns.
# Measured on 2026-10-20: Groq answers the short calls in 0.4 to 1 s and the brief in about 5 s; Gemini free tier needs
# 9 to 21 s and 13 to 16 s (3.5 Flash-Lite often answers 503). Groq's free tier allows 8000 tokens a minute PER MODEL, so
# the chains spread the load: the cheap calls start on the small, quick models and gpt-oss-120b is kept for the brief.
# The app counts the tokens each Groq model has used this minute (usage fields and x-ratelimit headers) and passes over a
# model that cannot take a request, so a brief never fails on a 429 it could have avoided.
LLM_CHAIN_FAST=groq:openai/gpt-oss-20b,groq:qwen/qwen3.8-27b,groq:openai/gpt-oss-120b,gemini:gemini-2.5-flash,gemini:gemini-3.5-flash-lite   # seeds, critic, baseline
LLM_CHAIN_MAIN=groq:openai/gpt-oss-120b,groq:qwen/qwen3.8-27b,gemini:gemini-2.5-flash,gemini:gemini-3.5-flash,gemini:gemini-3.5-flash-lite,groq:openai/gpt-oss-20b   # brief synthesis
# GROQ_TOKENS_PER_MINUTE=8000   # per-model limit assumed until Groq's own x-ratelimit headers say otherwise
# GROQ_TOKEN_LIMITS=openai/gpt-oss-120b=8000,qwen/qwen3.8-27b=6000   # per-model overrides
# LLM_CHAIN=...          # older single setting: used for any call type whose own chain above is unset
GEMINI_API_KEY=          # free from Google AI Studio
GROQ_API_KEY=            # free from console.groq.com; the first models in both chains. Set at least one key.

# Older settings still work when LLM_CHAIN is unset: GEMINI_MODEL / GROQ_MODEL are put first in the default
# chain, and LLM_PROVIDER=groq puts the Groq models first. LLM_PROVIDER=mock (offline scripted JSON, used by E2E)
# always wins.
# LLM_PROVIDER=gemini    # gemini | groq | mock
# GEMINI_MODEL=
# GROQ_MODEL=

# Signs the evidence a brief hands to the browser (refine, compare, shared links). Use a long random value,
# e.g. `openssl rand -base64 32`. Without it a random per-process secret is used and shared links stop
# verifying after every restart.
LEDGER_SECRET=

# Demo capacity (optional)
SHOWCASE_WARM_ON_BOOT=1   # production + QLOO_MODE=live: build the six showcase briefs one at a time after boot (0 = off)
MAX_CONCURRENT_BRIEFS=4   # briefs, refinements and comparisons running at once

# Development / test only
# SEED_CACHE=0                  # 1 (default): a repeated request reuses its seed plan; 0 turns the cache off (benchmarks)

# Operator only: lets `npm run warm -- --regenerate` rebuild the showcase briefs. Set the same value as WARM_TOKEN when running the script.
SHOWCASE_ADMIN_TOKEN=
WARM_TOKEN=
